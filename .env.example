APP_ENV=local
INVOICE_DB_PATH=ocr_master_table.db
INVOICE_DATA_DIR=data/input
MAX_UPLOAD_BYTES=20971520
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=350
OLLAMA_NUM_THREAD=8
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_SECONDS=120
OCR_TEXT_LIMIT=6000
OCR_TIMEOUT_SECONDS=25
MAX_IMAGE_PIXELS=40000000
MAX_PDF_PAGES=30
LAYOUTLM_MODEL=
# Leave empty for start_backend.ps1 to generate a local token; Docker requires an explicit token.
LOCAL_API_TOKEN=
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://arbatsarthak-commits.github.io
